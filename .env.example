# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=kadea_chat

# Mail — Gmail SMTP
# 1. Active la validation en 2 étapes sur ton compte Google
# 2. Crée un « Mot de passe d'application » : https://myaccount.google.com/apppasswords
# 3. Mets ton e-mail Gmail + ce mot de passe ci-dessous
MAIL_MAILER=smtp
MAIL_FROM_NAME=Kadea Chat
MAIL_FROM_ADDRESS=ton.email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ton.email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
