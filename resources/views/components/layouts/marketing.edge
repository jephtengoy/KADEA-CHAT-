<!DOCTYPE html>
<html
  lang="fr"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kadea Chat — Messagerie privée</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--floating">
      <div class="header__inner">
        <a href="{{ route('home') }}" class="landing__brand" aria-label="Kadea Chat, accueil">
          <span class="landing__brand-mark">K</span>
          <span>Kadea Chat</span>
        </a>
        <div class="header__right">
          @!themeToggle()
          @if(auth.user)
            @link({ route: 'dashboard', class: 'btn btn--primary btn--sm' })
              Mes discussions
            @end
          @else
            @link({ route: 'session.create', class: 'btn btn--ghost btn--sm' })
              Se connecter
            @end
            @link({ route: 'new_account.create', class: 'btn btn--primary btn--sm' })
              Créer un compte
            @end
          @end
        </div>
      </div>
    </header>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>
