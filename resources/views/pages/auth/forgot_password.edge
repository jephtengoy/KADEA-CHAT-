```edge
@layouts.auth()
  <h1 class="auth__title">Mot de passe oublié ?</h1>
  <p class="auth__sub">
    Saisis ton adresse e-mail pour recevoir un lien de réinitialisation.
  </p>

  @if(flashMessages.has('error'))
    <p class="auth__error" role="alert">
      {{ flashMessages.get('error') }}
    </p>
  @end

  @if(flashMessages.has('success'))
    <p class="auth__success" role="status">
      {{ flashMessages.get('success') }}
    </p>
  @end

  @form({
    route: 'password_resets.store',
    method: 'POST',
    class: 'auth__form'
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'you@example.com',
        required: true,
      })
      @!field.error()
    @end

    @!button({
      text: 'Envoyer le lien',
      type: 'submit',
      block: true,
    })
  @end

  <p class="auth__foot">
    @link({ route: 'session.create', class: 'il' })
      Retour à la connexion
    @end
  </p>
@end
```
