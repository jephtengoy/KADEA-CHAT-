
@layouts.auth()
  <h1 class="auth__title">Nouveau mot de passe</h1>
  <p class="auth__sub">
    Choisis un nouveau mot de passe pour ton compte Kadea Chat.
  </p>
  @if(flashMessages.has('error'))
    <p class="auth__error" role="alert">
      {{ flashMessages.get('error') }}
    </p>
  @end
  @form({
    route: 'password_resets.update',
    method: 'POST',
    class: 'auth__form'
  })
    <input type="hidden" name="token" value="{{ token }}">
    @field.root({ name: 'password' })
      @!field.label({ text: 'Nouveau mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '8 caractères minimum',
        required: true,
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmer le mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: 'Répète ton mot de passe',
        required: true,
      })
      @!field.error()
    @end
    @!button({
      text: 'Réinitialiser le mot de passe',
      type: 'submit',
      block: true,
    })
  @end
@end