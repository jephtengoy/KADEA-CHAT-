@layouts.auth()
  @if(flashMessages.has('error'))
    <p class="auth__error" role="alert">{{ flashMessages.get('error') }}</p>
  @end
  @if(flashMessages.has('success'))
    <p class="auth__success" role="status">{{ flashMessages.get('success') }}</p>
  @end

  <h1 class="auth__title">Content de te revoir</h1>
  <p class="auth__sub">Connecte-toi pour retrouver tes discussions.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'toi@exemple.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end

    <p class="auth__foot">
      @link({ route: 'password_resets.create', class: 'il' })
        Mot de passe oublié ?
      @end
    </p>
    @!button({
      text: 'Se connecter',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Connexion…' : 'Se connecter'",
    })
  @end

  <p class="auth__foot">
    Pas encore de compte ?
    @link({ route: 'new_account.create', class: 'il' })
      Créer un compte
    @end
  </p>
@end
