@layouts.auth()
edge
  @if(flashMessages.has('error'))
    <p class="auth__error" role="alert">
      {{ flashMessages.get('error') }}
    </p>
  @end

  @if(flashMessages.has('success'))
    <p class="auth__success" role="status">
      {{ flashMessages.get('success') }}
    </p>
  @end


  <h1 class="auth__title">Welcome back</h1>
  <p class="auth__sub">Sign in to continue building.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Password' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Sign in',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'One moment…' : 'Sign in'",
    })
  @end

  <p class="auth__foot">
    

    New here?


    @link({ route: 'new_account.create', class: 'il' })
      Create an account
    @end
  </p>
  ```edge
  <div class="auth__resend">
    <p>Tu n’as pas reçu l’e-mail de confirmation ?</p>

    @form({
      route: 'email_verifications.resend',
      method: 'POST',
      class: 'auth__form'
    })
      @field.root({ name: 'email' })
        @!field.label({ text: 'Ton adresse e-mail' })
        @!input.control({
          type: 'email',
          autocomplete: 'email',
          placeholder: 'you@example.com',
          required: true,
        })
        @!field.error()
      @end

      @!button({
        text: 'Renvoyer l’e-mail',
        type: 'submit',
        block: true,
      })
    @end
  </div>
```

@end
