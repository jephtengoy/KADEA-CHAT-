@let(initialTheme = request.plainCookie('app_theme', {
  defaultValue: 'light',
  encoded: false,
}))
@layouts.marketing()
  <main class="home">
    <div class="landing__glow landing__glow--one" aria-hidden="true"></div>
    <div class="landing__glow landing__glow--two" aria-hidden="true"></div>

    <section class="landing__hero" aria-labelledby="landing-title">
      <div class="landing__content">
        <span class="landing__eyebrow">
          <span class="landing__status-dot"></span>
          Kadea Chat · Messagerie en temps réel
        </span>

        <h1 id="landing-title">Restez connecté, simplement.</h1>
        <p class="landing__description">
          Échangez des messages en temps réel, retrouvez vos contacts et partagez des moments avec vos proches dans une expérience de messagerie simple, rapide et intuitive.
        </p>

        <div class="landing__actions">
          <a class="btn btn--primary landing__login" href="{{ route('session.create') }}">
            
            
            Se connecter


            @svg('lucide:arrow-right', { width: 17, height: 17 })
          </a>
          <a class="btn btn--secondary landing__signup" href="{{ route('new_account.create') }}">
            Créer un compte
          </a>
        </div>

        <p class="landing__note">
          @svg('lucide:mail-check', { width: 15, height: 15 })
          
          
          Confirmation du compte par Gmail


        </p>

        <div class="landing__features" aria-label="Fonctionnalités">
          <span>
            @svg('lucide:lock-keyhole', { width: 16, height: 16 })
            
            
 Conversations privées

          </span>
          <span>
            @svg('lucide:users-round', { width: 16, height: 16 })
            
            
 Discussions de groupe

          </span>
          <span>
            @svg('lucide:mic', { width: 16, height: 16 })
            
            
 Vocaux et fichiers

          </span>
        </div>
      </div>

      <div class="landing__visual">
        <div class="landing__orbit landing__orbit--outer" aria-hidden="true"></div>
        <div class="landing__orbit landing__orbit--inner" aria-hidden="true"></div>
        <div class="landing__toggle-wrap">
          <button
            type="button"
            class="landing__theme-toggle"
            data-initial-theme="{{ initialTheme }}"
            data-state="{{ initialTheme }}"
            x-data="themeToggle"
            x-bind:data-state="theme"
            x-bind:aria-label="theme === 'dark' ? 'Activer le thème clair' : 'Activer le thème sombre'"
            x-bind:title="theme === 'dark' ? 'Activer le thème clair' : 'Activer le thème sombre'"
            x-on:click="toggle"
          >
            <span class="landing__sky landing__sky--night" aria-hidden="true">
              <i class="landing__star landing__star--one"></i>
              <i class="landing__star landing__star--two"></i>
              <i class="landing__star landing__star--three"></i>
              <i class="landing__star landing__star--four"></i>
              <i class="landing__star landing__star--five"></i>
              <i class="landing__star landing__star--six"></i>
            </span>
            <span class="landing__sky landing__sky--day" aria-hidden="true"></span>
            <span class="landing__celestial landing__celestial--moon" aria-hidden="true">
              @svg('lucide:moon', { width: 58, height: 58 })
            </span>
            <span class="landing__celestial landing__celestial--sun" aria-hidden="true">
              @svg('lucide:sun', { width: 62, height: 62 })
            </span>
          </button>
          <p class="landing__theme-label">Le jour se lève, la nuit tombe.</p>
          <span class="landing__theme-hint">Clique sur le soleil ou la lune</span>
        </div>
        <span class="landing__spark landing__spark--one" aria-hidden="true">✳</span>
        <span class="landing__spark landing__spark--two" aria-hidden="true">✧</span>
      </div>
    </section>

    <footer class="landing__footer">
      <span>Une conversation à la fois.</span>
      <span>Simplement, avec Kadea Chat.</span>
    </footer>
  </main>
@end
